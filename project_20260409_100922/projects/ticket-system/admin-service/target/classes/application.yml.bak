# 管理服务配置
server:
  port: 8084
  servlet:
    context-path: /admin

spring:
  datasource:
    url: ${DB_URL:jdbc:mysql://localhost:3306/ticket_admin?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai}
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:123456}
    driver-class-name: com.mysql.cj.jdbc.Driver
    druid:
      initial-size: 5
      min-idle: 5
      max-active: 20
      max-wait: 60000
      time-between-eviction-runs-millis: 60000
      min-evictable-idle-time-millis: 300000
      validation-query: SELECT 1
      test-while-idle: true
      test-on-borrow: false
      test-on-return: false
      pool-prepared-statements: true
      max-pool-prepared-statement-per-connection-size: 20
      filters: stat,wall

  # Redis配置 - 主从模式（一主二从）
  data:
    redis:
      # 主节点负责写操作，从节点负责读操作（负载均衡）
      master:
        host: ${REDIS_HOST:localhost}
        port: ${REDIS_PORT:6379}
      # 从节点列表（格式: host:port），多个用逗号分隔
      slaves: ${REDIS_SLAVES:localhost:6380,localhost:6381}
      database: 0
      timeout: 10000ms
      lettuce:
        pool:
          max-active: 128         # 限流+库存+排队结果都需要Redis
          max-idle: 64            
          min-idle: 20            # 保持更多热连接
          max-wait: 3000ms        # 快速失败

  jackson:
    default-property-inclusion: non_null
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: Asia/Shanghai

mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.ticket.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: ASSIGN_ID
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# RocketMQ MQ配置
rocketmq:
  name-server: ${ROCKETMQ_NAMESRV:127.0.0.1:9876}
  producer:
    group: admin-service-producer-group
    send-message-timeout: 3000
    retry-times-when-send-failed: 3
    retry-times-when-send-async-failed: 2
    max-message-size: 4194304  # 4MB
    compress-message-body-over: 4096
    access-channel: LOCAL
    vip-channel-enabled: false   # 关闭VIP通道，兼容本地/非VIP环境
  # Consumer配置（通过@RocketMQMessageListener注解配置优先级更高）
  consumer:
    group: admin-service-consumer-group

# 日志配置
logging:
  level:
    com.ticket.admin: debug
    com.ticket.mapper: debug
    org.springframework.cloud.gateway: debug
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
    file: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
  file:
    path: logs
    name: logs/admin-service.log
    max-size: 10MB
    max-history: 30
  # 使用自定义logback配置（JSON格式输出给ELK）
  config: classpath:logback-spring.xml

# 自定义配置
ticket:
  admin:
    # 员工默认密码
    default-password: 123456
    # 密码加密盐值
    password-salt: ticket-admin
    # JWT配置
    jwt:
      secret: ${JWT_SECRET:ticket-admin-jwt-secret-key-2026}
      expire: 7200
      issuer: ticket-admin-service