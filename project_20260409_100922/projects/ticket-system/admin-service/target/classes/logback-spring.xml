<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="appName" value="admin-service"/>
    <include resource="logback-base.xml"/>

    <logger name="com.ticket.admin.service.impl.EmployeeServiceImpl" level="DEBUG"/>
    <logger name="com.ticket.admin.controller.EmployeeController" level="DEBUG"/>
    <logger name="com.ticket.admin.mapper" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE_JSON"/>
    </root>
</configuration>
