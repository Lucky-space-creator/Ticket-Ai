<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 引入Spring Boot默认的logback配置 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 自定义属性 -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="LOG_FILE_MAX_HISTORY" value="${LOG_FILE_MAX_HISTORY:-30}"/>
    <property name="LOG_FILE_MAX_SIZE" value="${LOG_FILE_MAX_SIZE:-100MB}"/>

    <!-- ==================== 控制台输出（开发调试用） ==================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== JSON日志输出（ELK采集用） ==================== -->
    <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/ticket-system.json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 按天滚动 -->
            <fileNamePattern>${LOG_PATH}/ticket-system.%d{yyyy-MM-dd}.%i.json.log</fileNamePattern>
            <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>

        <!-- 使用logstash-logback-encoder输出ELK友好的JSON格式 -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- 包含自定义字段 -->
            <customFields>{"app":"ticket-system","env":"${SPRING_PROFILES_ACTIVE:-dev}"}</customFields>
            <!-- 包含MDC字段（如traceId） -->
            <includeMdcKeyName>traceId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ==================== AI聊天专用日志（独立文件） ==================== -->
    <appender name="AI_CHAT_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/ai-chat-trace.json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/ai-chat-trace.%d{yyyy-MM-dd}.json.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>50MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"ticket-system","logType":"ai-chat-trace","env":"${SPRING_PROFILES_ACTIVE:-dev}"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ==================== 异步Appender（提升性能） ==================== -->
    <appender name="ASYNC_FILE_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE_JSON"/>
    </appender>

    <appender name="ASYNC_AI_CHAT" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="AI_CHAT_LOG"/>
    </appender>

    <!-- ==================== Logger级别配置 ==================== -->

    <!-- AI聊天相关Logger：单独输出到AI聊天日志文件 -->
    <logger name="com.ticket.util.AiChatStopWatch" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_AI_CHAT"/>
    </logger>

    <!-- AI服务层：DEBUG级别 -->
    <logger name="com.ticket.service.impl.AIChatServiceImpl" level="DEBUG"/>

    <!-- AI控制器 -->
    <logger name="com.ticket.controller.AIChatController" level="DEBUG"/>

    <!-- Mapper层SQL日志 -->
    <logger name="com.ticket.mapper" level="DEBUG"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE_JSON"/>
    </root>
</configuration>
